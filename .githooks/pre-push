#!/usr/bin/env bash
# Compile gates on every push: clippy -D warnings across all targets, the
# Nextest CI profile, and doctests. Hosted CI repeats these gates.
# Skip once with `git push --no-verify`; skip a session with
# `export YAH_SKIP_HOOKS=1` (empty, 0, and false do not skip).

set -euo pipefail

case "${YAH_SKIP_HOOKS:-}" in
  "" | 0 | false) ;;
  *) echo "pre-push: skipped (YAH_SKIP_HOOKS=${YAH_SKIP_HOOKS})"; exit 0 ;;
esac

cd "$(git rev-parse --show-toplevel)"

cargo clippy --locked --workspace --all-targets -- -D warnings
bash scripts/test.sh ci
