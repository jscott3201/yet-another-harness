package yah:plugin@0.1.0;

interface logging {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  record log-field {
    key: string,
    value: string,
  }

  log: func(level: log-level, message: string, fields: list<log-field>);
}

interface cancellation {
  is-cancelled: func() -> bool;
}

interface lifecycle {
  enum error-code {
    cancelled,
    invalid-state,
    failed,
  }

  record guest-error {
    code: error-code,
    message: string,
  }

  activate: func() -> result<_, guest-error>;
}

interface fixture-tool {
  enum error-code {
    invalid-input,
    cancelled,
    failed,
  }

  record guest-error {
    code: error-code,
    message: string,
  }

  invoke: func(input-json: string) -> result<string, guest-error>;
}

world conformance {
  import logging;
  import cancellation;

  export lifecycle;
  export fixture-tool;
}
