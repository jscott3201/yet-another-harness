      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "event",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Event"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "cursor_expired",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/CursorExpired"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "subscription_opened",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/SubscriptionOpened"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "subscription_pending",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/SubscriptionPending"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "slow_consumer",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/SlowConsumer"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "subscription_closed",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/SubscriptionClosed"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "error",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  ],
  "title": "ServerMessage"
}
