{
  "$defs": {
    "Actor": {
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "principal_kind": {
          "type": "string"
        }
      },
      "required": [
        "principal_kind",
        "principal_id"
      ],
      "type": "object"
    },
    "AdapterLimits": {
      "properties": {
        "durable_event_queue_capacity": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "progress_event_queue_capacity": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "durable_event_queue_capacity",
        "progress_event_queue_capacity"
      ],
      "type": "object"
    },
    "CursorExpired": {
      "properties": {
        "min_retained_cursor": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "min_retained_cursor"
      ],
      "type": "object"
    },
    "Error": {
      "properties": {
        "details": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "type": "string"
        },
        "occurrence_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reconcile_required": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "reason",
        "message",
        "retryable",
        "reconcile_required",
        "occurrence_id"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "not_found",
        "version_conflict",
        "idempotency_conflict",
        "fence_rejected",
        "journal_immutable",
        "policy_denied",
        "capability_unsupported",
        "approval_required",
        "resource_exhausted",
        "payload_too_large",
        "cursor_expired",
        "slow_consumer",
        "cancelled",
        "deadline_exceeded",
        "unavailable",
        "outcome_unknown",
        "internal"
      ],
      "type": "string"
    },
    "Event": {
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "aggregate_id": {
          "type": "string"
        },
        "aggregate_kind": {
          "type": "string"
        },
        "aggregate_version": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "event_kind": {
          "type": "string"
        },
        "event_version": {
          "const": 1,
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "ordinal": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "payload": {
          "additionalProperties": true,
          "type": "object"
        },
        "stream_class": {
          "$ref": "#/$defs/StreamClass"
        }
      },
      "required": [
        "event_id",
        "cursor",
        "stream_class",
        "aggregate_kind",
        "aggregate_id",
        "aggregate_version",
        "ordinal",
        "event_kind",
        "event_version",
        "occurred_at",
        "actor",
        "payload"
      ],
      "type": "object"
    },
    "Receipt": {
      "properties": {
        "command_id": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_cursors": {
          "items": {
            "maxLength": 20,
            "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
            "type": "string"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ReceiptOutcome"
        },
        "receipt_version": {
          "const": 1,
          "type": "integer"
        },
        "result": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "state_version": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command_id",
        "scope",
        "outcome",
        "event_cursors",
        "receipt_version"
      ],
      "type": "object"
    },
    "ReceiptOutcome": {
      "enum": [
        "accepted",
        "completed",
        "replayed",
        "rejected",
        "outcome_unknown"
      ],
      "type": "string"
    },
    "Retention": {
      "properties": {
        "max_age_seconds": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "max_events_per_project": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "min_retained_cursor": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "min_retained_cursor",
        "max_age_seconds",
        "max_events_per_project"
      ],
      "type": "object"
    },
    "Scope": {
      "properties": {
        "scope_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        "scope_kind": {
          "$ref": "#/$defs/ScopeKind"
        }
      },
      "required": [
        "scope_kind",
        "scope_id"
      ],
      "type": "object"
    },
    "ScopeKind": {
      "enum": [
        "global",
        "project",
        "run",
        "unit"
      ],
      "type": "string"
    },
    "SlowConsumer": {
      "properties": {
        "last_delivered_cursor": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "min_retained_cursor": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "min_retained_cursor",
        "last_delivered_cursor"
      ],
      "type": "object"
    },
    "StreamClass": {
      "enum": [
        "durable_semantic",
        "progress",
        "telemetry"
      ],
      "type": "string"
    },
    "SubscriptionClosed": {
      "properties": {
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "subscription_id"
      ],
      "type": "object"
    },
    "SubscriptionOpened": {
      "properties": {
        "limits": {
          "$ref": "#/$defs/AdapterLimits"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "subscription_id",
        "limits",
        "retention"
      ],
      "type": "object"
    },
    "SubscriptionPending": {
      "properties": {
        "subscription_id": {
          "type": "string"
        }
      },
      "required": [
        "subscription_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
